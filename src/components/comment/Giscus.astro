---
import { getCollection } from "astro:content";
import { commentConfig } from "@/config";
import { dynamicSlug } from "@/utils/dynamic-utils";

if (!commentConfig?.giscus) {
	throw new Error("Giscus comments are not configured");
}

const giscus = commentConfig.giscus;
const baseUrl = import.meta.env.BASE_URL;
const isDynamicEmbed = Astro.url.pathname === "/dynamic/comments/";
const allowedPaths = isDynamicEmbed
	? (await getCollection("dynamic")).map(
			(entry) => `/dynamic/${dynamicSlug(entry.id)}/`,
		)
	: [];
---

<div id="comments" class="giscus"></div>

<script is:inline define:vars={{ giscus, baseUrl, isDynamicEmbed, allowedPaths }}>
(() => {
  const container = document.currentScript.previousElementSibling;
  if (container.childElementCount) return;
  const requestedPath = new URLSearchParams(window.location.search).get("path");
  const commentPath = isDynamicEmbed && allowedPaths.includes(requestedPath) ? requestedPath : null;
  // 잘못된 한마디 경로에 공용 Discussion을 생성하지 않는다.
  if (isDynamicEmbed && !commentPath) return;
  const getTheme = () => new URL(
    `${baseUrl}giscus/${document.documentElement.classList.contains("dark") ? "dark" : "light"}.css`,
    window.location.origin,
  ).href;
  const loader = document.createElement("script");
  loader.src = "https://giscus.app/client.js";
  loader.async = true;
  loader.crossOrigin = "anonymous";
  loader.dataset.swupIgnoreScript = "";
  const options = {
    repo: giscus.repo,
    "repo-id": giscus.repoId,
    category: giscus.category,
    "category-id": giscus.categoryId,
    mapping: commentPath ? "specific" : giscus.mapping,
    strict: giscus.strict,
    "reactions-enabled": giscus.reactionsEnabled,
    "emit-metadata": giscus.emitMetadata,
    "input-position": giscus.inputPosition,
    theme: getTheme(),
    lang: giscus.lang,
    loading: giscus.loading,
  };
  if (commentPath) options.term = commentPath;
  for (const [name, value] of Object.entries(options)) {
    loader.setAttribute(`data-${name}`, value);
  }

  let currentTheme = options.theme;
  function updateTheme() {
    const theme = getTheme();
    if (theme === currentTheme) return;
    currentTheme = theme;
    // 로딩 중 모드를 바꾸면 iframe의 load 시점에도 최신 테마를 적용한다.
    container.querySelector("iframe.giscus-frame")?.contentWindow.postMessage(
      { giscus: { setConfig: { theme } } }, "https://giscus.app",
    );
  }
  const observer = new MutationObserver(updateTheme);
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
  function syncLoadedTheme(event) {
    if (!event.target.matches?.("iframe.giscus-frame")) return;
    if (getTheme() === options.theme) return;
    event.target.contentWindow.postMessage(
      { giscus: { setConfig: { theme: getTheme() } } }, "https://giscus.app",
    );
  }
  container.addEventListener("load", syncLoadedTheme, true);
  let hooks;
  function registerCleanup() {
    hooks = window.swup?.hooks;
    hooks?.before("content:replace", cleanup);
  }
  function cleanup() {
    observer.disconnect();
    container.removeEventListener("load", syncLoadedTheme, true);
    document.removeEventListener("swup:enable", registerCleanup);
    hooks?.off("content:replace", cleanup);
    container.replaceChildren();
  }
  if (window.swup?.hooks) registerCleanup();
  else document.addEventListener("swup:enable", registerCleanup, { once: true });
  container.appendChild(loader);
})();
</script>

<style>
  .giscus,
  .giscus :global(iframe.giscus-frame) {
    display: block;
    width: 100%;
    min-width: 0;
    margin: 0;
    border: 0;
  }
</style>
