---
import { commentConfig } from "@/config";

if (!commentConfig?.giscus) {
	throw new Error("Giscus comments are not configured");
}

const giscus = commentConfig.giscus;
const themePath = `${import.meta.env.BASE_URL}giscus/firefly.css`;
---

<div id="comments" class="giscus"></div>

<script is:inline define:vars={{ giscus, themePath }}>
(() => {
  const container = document.currentScript.previousElementSibling;
  const requestedPath = new URLSearchParams(window.location.search).get("path");
  const loader = document.createElement("script");
  loader.src = "https://giscus.app/client.js";
  loader.async = true;
  loader.crossOrigin = "anonymous";
  const options = {
    repo: giscus.repo,
    "repo-id": giscus.repoId,
    category: giscus.category,
    "category-id": giscus.categoryId,
    mapping: requestedPath ? "specific" : giscus.mapping,
    strict: giscus.strict,
    "reactions-enabled": giscus.reactionsEnabled,
    "emit-metadata": giscus.emitMetadata,
    "input-position": giscus.inputPosition,
    theme: new URL(themePath, window.location.origin).href,
    lang: giscus.lang,
    loading: giscus.loading,
  };
  if (requestedPath) options.term = requestedPath;
  for (const [name, value] of Object.entries(options)) {
    loader.setAttribute(`data-${name}`, value);
  }

  container.appendChild(loader);
})();
</script>

<style>
  .giscus,
  .giscus :global(iframe.giscus-frame) {
    display: block;
    width: 100%;
    min-width: 0;
    margin: 0;
    border: 0;
  }

  .giscus :global(iframe.giscus-frame) {
    color-scheme: light;
  }

  :global(html.dark) .giscus :global(iframe.giscus-frame) {
    color-scheme: dark;
  }
</style>
